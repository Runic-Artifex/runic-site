{"package":"@runic-artifex/react","version":"0.7.0-preview.5","modules":["@runic-artifex/react"],"types":[{"id":"npm:@runic-artifex/react:CollectionViewport","namespace":"@runic-artifex/react","name":"CollectionViewport","kind":"reexport","signature":["export { CollectionViewport } from '@runic-artifex/views'"],"reexport":"npm:@runic-artifex/views:CollectionViewport"},{"id":"npm:@runic-artifex/react:CollectionViewportHandle","namespace":"@runic-artifex/react","name":"CollectionViewportHandle","kind":"interface","signature":["interface ",["CollectionViewportHandle","npm:@runic-artifex/react:CollectionViewportHandle"]],"members":[{"id":"npm:@runic-artifex/react:CollectionViewportHandle.viewport","kind":"property","name":"viewport","signature":["readonly viewport: ",["CollectionViewport","npm:@runic-artifex/react:CollectionViewport"],";"],"docs":{"summary":["The rows to request and the sizes to render."]}},{"id":"npm:@runic-artifex/react:CollectionViewportHandle.ref","kind":"property","name":"ref","signature":["readonly ref: (element: HTMLElement | null) => void;"],"docs":{"summary":["Attach to the scroll container: ",{"c":"<div ref={ref}>"},"."]}}]},{"id":"npm:@runic-artifex/react:CollectionViewportOptions","namespace":"@runic-artifex/react","name":"CollectionViewportOptions","kind":"reexport","signature":["export { CollectionViewportOptions } from '@runic-artifex/views'"],"reexport":"npm:@runic-artifex/views:CollectionViewportOptions"},{"id":"npm:@runic-artifex/react:CommandHandle","namespace":"@runic-artifex/react","name":"CommandHandle","kind":"interface","signature":["interface ",["CommandHandle","npm:@runic-artifex/react:CommandHandle"],"<TArgs extends readonly unknown[], TResult, TFailure = BridgeOutcomeFailure<TResult>>"],"members":[{"id":"npm:@runic-artifex/react:CommandHandle.run","kind":"method","name":"run","signature":["run(...args: TArgs): Promise<TResult | undefined>;"],"docs":{"summary":["Runs the command. Resolves to its result, including a ",{"c":"BridgeOutcome"}," with a declared failure, which ",{"c":"failure"}," then holds, or to undefined after an unexpected failure, which ",{"c":"error"}," then holds. Never rejects."]}},{"id":"npm:@runic-artifex/react:CommandHandle.pending","kind":"property","name":"pending","signature":["readonly pending: boolean;"],"docs":{"summary":["True while a run is in flight."]}},{"id":"npm:@runic-artifex/react:CommandHandle.error","kind":"property","name":"error","signature":["readonly error: unknown;"],"docs":{"summary":["Why the latest run failed unexpectedly, until the next run starts."]}},{"id":"npm:@runic-artifex/react:CommandHandle.failure","kind":"property","name":"failure","signature":["readonly failure: TFailure | undefined;"],"docs":{"summary":["The declared failure of the latest run, for a command that resolves a ",{"c":"BridgeOutcome"},", until the next run starts. A superseded run sets neither."]}},{"id":"npm:@runic-artifex/react:CommandHandle.reset","kind":"method","name":"reset","signature":["reset(): void;"],"docs":{"summary":["Clears ",{"c":"error"}," and ",{"c":"failure"},"."]}}]},{"id":"npm:@runic-artifex/react:retrySuspenseView","namespace":"@runic-artifex/react","name":"retrySuspenseView","kind":"function","signature":["function retrySuspenseView(source: ",["ViewConnector","npm:@runic-artifex/react:ViewConnector"],"<",["ViewClient","npm:@runic-artifex/react:ViewClient"],">): void;"],"docs":{"summary":["Forgets a failed ",{"c":"useSuspenseView"}," connection, so the next render connects again. Call it from an error boundary's reset before rendering the component again. A connection that is pending or connected is unaffected."]}},{"id":"npm:@runic-artifex/react:SuspenseViewHandle","namespace":"@runic-artifex/react","name":"SuspenseViewHandle","kind":"interface","signature":["interface ",["SuspenseViewHandle","npm:@runic-artifex/react:SuspenseViewHandle"],"<TClient extends ",["ViewClient","npm:@runic-artifex/react:ViewClient"],">"],"members":[{"id":"npm:@runic-artifex/react:SuspenseViewHandle.state","kind":"property","name":"state","signature":["readonly state: TClient[\"snapshot\"];"],"docs":{"summary":["The latest state."]}},{"id":"npm:@runic-artifex/react:SuspenseViewHandle.client","kind":"property","name":"client","signature":["readonly client: TClient;"],"docs":{"summary":["The connected client."]}}]},{"id":"npm:@runic-artifex/react:useCollectionViewport","namespace":"@runic-artifex/react","name":"useCollectionViewport","kind":"function","signature":["function useCollectionViewport(options: ",["CollectionViewportOptions","npm:@runic-artifex/react:CollectionViewportOptions"],"): ",["CollectionViewportHandle","npm:@runic-artifex/react:CollectionViewportHandle"],";"],"docs":{"summary":["Follows a fixed-row-height scroll container and returns the rows to request from .NET. Send ",{"c":"viewport.start"}," and ",{"c":"viewport.size"}," to the ViewModel from an effect; the hook only measures."]}},{"id":"npm:@runic-artifex/react:useCommand","namespace":"@runic-artifex/react","name":"useCommand","kind":"function","signature":["function useCommand<TArgs extends readonly unknown[], TReturn>(command: (...args: TArgs) => TReturn): ",["CommandHandle","npm:@runic-artifex/react:CommandHandle"],"<TArgs, Awaited<TReturn>>;"],"docs":{"summary":["Tracks a command's pending state and failure for rendering. ",{"c":"run"}," always calls the latest ",{"c":"command"},", so it may close over the current client: ",{"pre":"const increment = useCommand(() => client?.increment());\n<button disabled={!client || increment.pending} onClick={() => increment.run()}>…</button>"}]}},{"id":"npm:@runic-artifex/react:useSuspenseView","namespace":"@runic-artifex/react","name":"useSuspenseView","kind":"function","signature":["function useSuspenseView<TClient extends ",["ViewClient","npm:@runic-artifex/react:ViewClient"],">(source: ",["ViewConnector","npm:@runic-artifex/react:ViewConnector"],"<TClient> | TClient): ",["SuspenseViewHandle","npm:@runic-artifex/react:SuspenseViewHandle"],"<TClient>;"],"docs":{"summary":["Suspends the component until a generated View reference connects, then renders its state. A failed connection is thrown to the nearest error boundary; call ",{"c":"retrySuspenseView(reference)"}," when resetting the boundary to connect again. An unretried failure is forgotten after ten seconds. Components that pass a reference with the same ",{"c":"connect"}," function share one client, which is disposed after the last of them unmounts. Pass a stable function such as a generated page reference or ",{"c":"{ connect: connectWorkspace }"},": a function recreated on every render never resolves. An already connected client is observed and left to its owner."]}},{"id":"npm:@runic-artifex/react:useView","namespace":"@runic-artifex/react","name":"useView","kind":"function","signature":["function useView<TClient extends ",["ViewClient","npm:@runic-artifex/react:ViewClient"],">(source: ",["ViewSource","npm:@runic-artifex/react:ViewSource"],"<TClient>): ",["ViewHandle","npm:@runic-artifex/react:ViewHandle"],"<TClient>;"],"docs":{"summary":["Connects a generated View reference for the lifetime of the component and renders its state through ",{"c":"useSyncExternalStore"},". A changed reference disposes the previous client; StrictMode's extra mount disposes its connection when it resolves. A reference is identified by its ",{"c":"connect"}," function, so an inline ",{"c":"{ connect: connectWorkspace }"}," does not reconnect. In development a ",{"c":"connect"}," function recreated on every render logs a warning."]}},{"id":"npm:@runic-artifex/react:ViewClient","namespace":"@runic-artifex/react","name":"ViewClient","kind":"reexport","signature":["export { ViewClient } from '@runic-artifex/views'"],"reexport":"npm:@runic-artifex/views:ViewClient"},{"id":"npm:@runic-artifex/react:ViewConnector","namespace":"@runic-artifex/react","name":"ViewConnector","kind":"reexport","signature":["export { ViewConnector } from '@runic-artifex/views'"],"reexport":"npm:@runic-artifex/views:ViewConnector"},{"id":"npm:@runic-artifex/react:ViewHandle","namespace":"@runic-artifex/react","name":"ViewHandle","kind":"interface","signature":["interface ",["ViewHandle","npm:@runic-artifex/react:ViewHandle"],"<TClient extends ",["ViewClient","npm:@runic-artifex/react:ViewClient"],">"],"members":[{"id":"npm:@runic-artifex/react:ViewHandle.state","kind":"property","name":"state","signature":["readonly state: TClient[\"snapshot\"] | undefined;"],"docs":{"summary":["The latest state, or undefined until the client connects."]}},{"id":"npm:@runic-artifex/react:ViewHandle.client","kind":"property","name":"client","signature":["readonly client: TClient | undefined;"],"docs":{"summary":["The connected client for commands, or undefined until it connects."]}},{"id":"npm:@runic-artifex/react:ViewHandle.error","kind":"property","name":"error","signature":["readonly error: unknown;"],"docs":{"summary":["The connection failure, if any."]}},{"id":"npm:@runic-artifex/react:ViewHandle.pending","kind":"property","name":"pending","signature":["readonly pending: boolean;"],"docs":{"summary":["True while a reference is connecting."]}},{"id":"npm:@runic-artifex/react:ViewHandle.retry","kind":"method","name":"retry","signature":["retry(): void;"],"docs":{"summary":["Connects a reference again after a failure."]}}]},{"id":"npm:@runic-artifex/react:ViewOutlet","namespace":"@runic-artifex/react","name":"ViewOutlet","kind":"function","signature":["function ",["ViewOutlet","npm:@runic-artifex/react:ViewOutlet"],"<R extends ",["ViewReference","npm:@runic-artifex/react:ViewReference"],">({ content, registry, fallback }: ",["ViewOutletProps","npm:@runic-artifex/react:ViewOutletProps"],"<R>): ReactNode;"],"docs":{"summary":["Renders the registered component for a generated View reference and passes the reference as its ",{"c":"page"}," prop. A different reference remounts the component. A kind without a component renders an alert."]}},{"id":"npm:@runic-artifex/react:ViewOutletProps","namespace":"@runic-artifex/react","name":"ViewOutletProps","kind":"interface","signature":["interface ",["ViewOutletProps","npm:@runic-artifex/react:ViewOutletProps"],"<R extends ",["ViewReference","npm:@runic-artifex/react:ViewReference"],">"],"members":[{"id":"npm:@runic-artifex/react:ViewOutletProps.content","kind":"property","name":"content","signature":["readonly content: R | null | undefined;"],"docs":{"summary":["The presented reference, such as ",{"c":"state.main"},"."]}},{"id":"npm:@runic-artifex/react:ViewOutletProps.registry","kind":"property","name":"registry","signature":["readonly registry: ",["ViewRegistry","npm:@runic-artifex/react:ViewRegistry"],"<R>;"]},{"id":"npm:@runic-artifex/react:ViewOutletProps.fallback","kind":"property","name":"fallback","signature":["readonly fallback?: ReactNode;"],"docs":{"summary":["Rendered while there is no content. Defaults to nothing."]}}]},{"id":"npm:@runic-artifex/react:ViewReference","namespace":"@runic-artifex/react","name":"ViewReference","kind":"reexport","signature":["export { ViewReference } from '@runic-artifex/views'"],"reexport":"npm:@runic-artifex/views:ViewReference"},{"id":"npm:@runic-artifex/react:ViewRegistry","namespace":"@runic-artifex/react","name":"ViewRegistry","kind":"type","signature":["type ",["ViewRegistry","npm:@runic-artifex/react:ViewRegistry"],"<R extends ",["ViewReference","npm:@runic-artifex/react:ViewReference"],"> = {\n    readonly [K in R[\"kind\"]]: ComponentType<{\n        readonly page: Extract<R, {\n            readonly kind: K;\n        }>;\n    }>;\n};"],"docs":{"summary":["A build-known map checks each generated reference kind against its component's ",{"c":"page"}," prop."]}},{"id":"npm:@runic-artifex/react:ViewSource","namespace":"@runic-artifex/react","name":"ViewSource","kind":"reexport","signature":["export { ViewSource } from '@runic-artifex/views'"],"reexport":"npm:@runic-artifex/views:ViewSource"}]}
