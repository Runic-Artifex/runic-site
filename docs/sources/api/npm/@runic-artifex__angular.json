ed client for commands, or undefined until it connects."]}},{"id":"npm:@runic-artifex/angular:ViewHandle.error","kind":"property","name":"error","signature":["readonly error: Signal<unknown>;"],"docs":{"summary":["The connection failure, if any."]}},{"id":"npm:@runic-artifex/angular:ViewHandle.pending","kind":"property","name":"pending","signature":["readonly pending: Signal<boolean>;"],"docs":{"summary":["True while a reference is connecting."]}},{"id":"npm:@runic-artifex/angular:ViewHandle.retry","kind":"method","name":"retry","signature":["retry(): void;"],"docs":{"summary":["Connects a reference again after a failure."]}}]},{"id":"npm:@runic-artifex/angular:ViewOutlet","namespace":"@runic-artifex/angular","name":"ViewOutlet","kind":"class","signature":["class ",["ViewOutlet","npm:@runic-artifex/angular:ViewOutlet"],"<R extends PageReference = PageReference>"],"docs":{"summary":["Headless host for a selected logical .NET View. A changed reference remounts its component, and the projected content renders while there is no reference. A kind without a component renders the ",{"c":"missing"}," template, for example localized text, or an English alert without it: ",{"pre":"<runic-view-outlet [content]=\"state()?.main\" [registry]=\"pages\" [missing]=\"missingView\" />\n<ng-template #missingView let-page><p role=\"alert\">{{ missingText(page.kind) }}</p></ng-template>"}," The element keeps Angular's prefix convention: ",{"c":"<runic-view-outlet [content]=\"…\" [registry]=\"…\" />"},"."]},"members":[{"id":"npm:@runic-artifex/angular:ViewOutlet.content","kind":"property","name":"content","signature":["readonly content: InputSignal<R | null | undefined>;"]},{"id":"npm:@runic-artifex/angular:ViewOutlet.registry","kind":"property","name":"registry","signature":["readonly registry: InputSignal<",["ViewRegistry","npm:@runic-artifex/angular:ViewRegistry"],"<R>>;"]},{"id":"npm:@runic-artifex/angular:ViewOutlet.missing","kind":"property","name":"missing","signature":["readonly m