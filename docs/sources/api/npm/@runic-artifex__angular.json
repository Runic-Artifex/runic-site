 TReturn, options?: ",["InjectCommandOptions","npm:@runic-artifex/angular:InjectCommandOptions"],"): ",["CommandHandle","npm:@runic-artifex/angular:CommandHandle"],"<TArgs, Awaited<TReturn>>;"],"docs":{"summary":["Tracks a command's pending state and failure as signals for the lifetime of the injection context. The command may read signals, such as a client: ",{"pre":"readonly increment = injectCommand(() => this.counter.client()?.increment());\n// <button [disabled]=\"!counter.client() || increment.pending()\" (click)=\"increment.run()\">"}]}},{"id":"npm:@runic-artifex/angular:InjectCommandOptions","namespace":"@runic-artifex/angular","name":"InjectCommandOptions","kind":"interface","signature":["interface ",["InjectCommandOptions","npm:@runic-artifex/angular:InjectCommandOptions"]],"members":[{"id":"npm:@runic-artifex/angular:InjectCommandOptions.injector","kind":"property","name":"injector","signature":["readonly injector?: Injector;"],"docs":{"summary":["Required outside an injection context."]}}]},{"id":"npm:@runic-artifex/angular:injectLatestOperation","namespace":"@runic-artifex/angular","name":"injectLatestOperation","kind":"function","signature":["function injectLatestOperation<TResult = void, TFailure = never>({ injector: provided }?: ",["InjectLatestOperationOptions","npm:@runic-artifex/angular:InjectLatestOperationOptions"],"): ",["LatestOperationHandle","npm:@runic-artifex/angular:LatestOperationHandle"],"<TResult, TFailure>;"],"docs":{"summary":["Admits only the newest selection, for reads such as \"load the selected item\", as signals for the lifetime of the injection context. Each ",{"c":"run(intent)"}," replaces the queued intent and cancels the active read, and the next read starts only after the previous one has finished (including ",{"c":"waitForCompletion"},"). ",{"c":"blocked"}," means admission is uncertain; only ",{"c":"clear(\"replace\")"},", after the application has established a fresh session, clears it. Destruction settles run promises without cancelling accepted work. ```ts readonly load = injectLatestOperation<Item>(); select(id: string) { void this.load.run({ start: () => this.items.client()?.startLoad(id) }); } //"]}},{"id":"npm:@runic-artifex/angular:InjectLatestOperationOptions","namespace":"@runic-artifex/angular","name":"InjectLatestOperationOptions","kind":"interface","signature":["interface ",["InjectLatestOperationOptions","npm:@runic-artifex/angular:InjectLatestOperationOptions"]],"members":[{"id":"npm:@runic-artifex/angular:InjectLatestOperationOptions.injector","kind":"property","name":"injector","signature":["readonly injector?: Injector;"],"docs":{"summary":["Required outside an injection context."]}}]},{"id":"npm:@runic-artifex/angular:injectMenuBar","namespace":"@runic-artifex/angular","name":"injectMenuBar","kind":"function","signature":["function injectMenuBar({ injector: provided, onRequest, ...options }?: ",["InjectMenuBarOptions","npm:@runic-artifex/angular:InjectMenuBarOptions"],"): ",["MenuBarHandle","npm:@runic-artifex/angular:MenuBarHandle"],";"],"docs":{"summary":["Follows the window's declared menu bar (Runic Desktop's ",{"c":"DesktopMenuBarPresentation.Page"},") as a signal, as headless state for the application's own menubar (for example the CDK Menu's ",{"c":"cdkMenuBar"},"), through ",{"c":"createMenuBarController"},", for the lifetime of the injection context. Destruction disposes the controller. Under server rendering (",{"c":"PLATFORM_ID"}," ",{"c":"\"server\""},") it creates none and stays ",{"c":"connecting"},". ```ts readonly menuBar = injectMenuBar({ onRequest: request => this.onMenuRequest(request) }); //"]}},{"id":"npm:@runic-artifex/angular:InjectMenuBarOptions","namespace":"@runic-artifex/angular","name":"InjectMenuBarOptions","kind":"interface","signature":["interface ",["InjectMenuBarOptions","npm:@runic-artifex/angular:InjectMenuBarOptions"]," extends Omit<MenuBarControllerOptions, \"signal\">"],"members":[{"id":"npm:@runic-artifex/angular:InjectMenuBarOptions.onRequest","kind":"property","name":"onRequest","signature":["readonly onRequest?: (request: ",["MenuBarRequest","npm:@runic-artifex/angular:MenuBarRequest"],") => void;"],"docs":{"summary":["Receives the ",{"c":"focus"}," (Alt tap, F10) and ",{"c":"open"}," (Alt plus a menu's access key) requests: focus the first ",{"c":"cdkMenuItem"}," of the bar or open a menu's ",{"c":"CdkMenuTrigger"},"."]}},{"id":"npm:@runic-artifex/angular:InjectMenuBarOptions.injector","kind":"property","name":"injector","signature":["readonly injector?: Injector;"],"docs":{"summary":["Required outside an injection context."]}}]},{"id":"npm:@runic-artifex/angular:injectOperation","namespace":"@runic-artifex/angular","name":"injectOperation","kind":"function","signature":["function injectOperation<TArgs extends readonly unknown[], TResult, TFailure = never>(start: (...args: TArgs) => BridgeOperation<TResult, TFailure> | undefined | PromiseLike<BridgeOperation<TResult, TFailure> | undefined>, { injector: provided, ...options }?: ",["InjectOperationOptions","npm:@runic-artifex/angular:InjectOperationOptions"],"<TResult, TFailure>): ",["OperationHandle","npm:@runic-artifex/angular:OperationHandle"],"<TArgs, TResult, TFailure>;"],"docs":{"summary":["Tracks Start admission, pending work, cancellation and terminal feedback of a generated ",{"c":"start<Command>()"}," operation as signals for the lifetime of the injection context. A run that ends ",{"c":"cancelled"}," sets ",{"c":"cancelled"},", not ",{"c":"error"},". Destruction settles run promises without cancelling accepted work. ```ts readonly push = injectOperation((remote: string) => this.workspace.client()?.startPush(remote)); // <button [disabled]=\"push.pending()\" (click)=\"push.run('origin')\">Push</button> //"]}},{"id":"npm:@runic-artifex/angular:InjectOperationOptions","namespace":"@runic-artifex/angular","name":"InjectOperationOptions","kind":"interface","signature":["interface ",["InjectOperationOptions","npm:@runic-artifex/a