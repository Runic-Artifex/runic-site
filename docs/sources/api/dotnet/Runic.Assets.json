":"AssetMediaTypes","kind":"class","signature":["public static class AssetMediaTypes"],"docs":{"summary":["Provides deterministic, platform-independent asset media types."]},"members":[{"id":"M:Runic.Assets.AssetMediaTypes.Resolve(System.String)","kind":"method","name":"Resolve","signature":["public static string Resolve(string relativePath)"],"docs":{"summary":["Resolves a known media type, falling back to ",{"c":"application/octet-stream"},"."]}}]},{"id":"T:Runic.Assets.AssetPath","namespace":"Runic.Assets","name":"AssetPath","kind":"class","signature":["public static class AssetPath"],"docs":{"summary":["Validates application-relative asset paths at every trust boundary."]},"members":[{"id":"M:Runic.Assets.AssetPath.Normalize(System.String)","kind":"method","name":"Normalize","signature":["public static string Normalize(string value)"],"docs":{"summary":["Returns the canonical slash-separated form of a safe application-relative path."],"exceptions":[{"cref":"T:System.ArgumentException","doc":["The path is empty, rooted, ambiguous, or contains unsupported characters."]}]}},{"id":"M:Runic.Assets.AssetPath.TryNormalize(System.String,System.String@)","kind":"method","name":"TryNormalize","signature":["public static bool TryNormalize(string? value, out string? normalized)"],"docs":{"summary":["Returns whether a path is a safe application-relative asset path and, if so, its canonical slash-separated form. Use this for untrusted request paths; it never throws."]}}]},{"id":"T:Runic.Assets.AssetReadSnapshot","namespace":"Runic.Assets","name":"AssetReadSnapshot","kind":"class","interfaces":["T:System.IAsyncDisposable","T:System.IDisposable"],"signature":["public sealed class AssetReadSnapshot : ",["IAsyncDisposable","T:System.IAsyncDisposable"],", ",["IDisposable","T:System.IDisposable"]],"docs":{"summary":["Owns one descriptor and the verified content stream it describes."]},"members":[{"id":"M:Runic.Assets.AssetReadSnapshot.#ctor(Runic.Assets.AssetDescriptor,System.IO.St