ublic AssetRoutingOptions()"]},{"id":"P:Runic.Assets.AssetRoutingOptions.ContentSecurityPolicy","kind":"property","name":"ContentSecurityPolicy","signature":["public string? ContentSecurityPolicy { get; init; }"],"docs":{"summary":["Gets the ",{"c":"Content-Security-Policy"}," header value that the host adapters send with every ",{"c":"text/html"}," asset, or ",{"c":"null"},", the default, for none. Other assets are sent without it."],"remarks":["The value is the policy as it appears in the header, such as ",{"c":"default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"},". It must be printable ASCII: a carriage return, line feed, NUL or other control character throws ",{"see":"T:System.ArgumentException"},". Runic Desktop sends its own ",{"c":"frame-ancestors"}," policy as a second header, and a browser enforces both. The archive does not carry a policy: script and connect origins are the application's to choose."],"exceptions":[{"cref":"T:System.ArgumentException","doc":["The value is empty or contains a character that a header cannot carry."]}]}},{"id":"P:Runic.Assets.AssetRoutingOptions.EnableSinglePageApplicationFallback","kind":"property","name":"EnableSinglePageApplicationFallback","signature":["public bool EnableSinglePageApplicationFallback { get; init; }"],"docs":{"summary":["Gets whether a missing path whose last segment has no file extension resolves to the manifest entry point, so client-side routes survive a reload. Defaults to ",{"c":"true"},"."]}},{"id":"P:Runic.Assets.AssetRoutingOptions.ServeEntryPointAtRoot","kind":"property","name":"ServeEntryPointAtRoot","signature":["public bool ServeEntryPointAtRoot { get; init; }"],"docs":{"summary":["Gets whether an empty path or ",{"c":"/"}," resolves to the manifest entry point. Defaults to ",{"c":"true"},"."]}}]},{"id":"T:Runic.Assets.AssetSourceChangedEventArgs","namespace":"Runic.Assets","name":"AssetSourceChangedEventArgs","kind":"class","base":"T:System.EventArgs","signature":["