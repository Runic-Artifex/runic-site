marks":["The view takes the folder's assets from the manifest ",{"c":"source"}," has when it is created, and opens them through ",{"c":"source"},". Create a new view after a live source, such as a ",{"see":"T:Runic.Assets.DevelopmentDirectoryAssetSource"},", changes: an asset whose content changed since then fails to open with ",{"see":"T:System.IO.InvalidDataException"},". ",{"see":"M:Runic.Assets.IAssetSource.ValidateAsync(System.Threading.CancellationToken)"}," verifies the folder's assets only. Every host adapter serves the view as it serves any source, for example ",{"c":"RunicDesktopHostOptions.Assets = archive.Subdirectory(\"settings\")"},"."],"returns":["A source that serves the folder's assets at its root."],"params":[{"name":"source","doc":["The source, such as an ",{"see":"T:Runic.Assets.AssetArchiveSource"}," that holds several frontends."]},{"name":"path","doc":["The folder, relative to the source, such as ",{"c":"settings"}," or ",{"c":"windows/settings/"},"."]},{"name":"entryPoint","doc":["The entry document, relative to the folder; ",{"c":"index.html"}," by default."]}],"exceptions":[{"cref":"T:System.ArgumentNullException","doc":["An argument is ",{"c":"null"},"."]},{"cref":"T:System.ArgumentException","doc":[{"c":"path"}," or ",{"c":"entryPoint"}," is not a safe relative asset path (",{"see":"M:Runic.Assets.AssetPath.Normalize(System.String)"},")."]},{"cref":"T:System.IO.DirectoryNotFoundException","doc":["No asset of ",{"c":"source"}," is in the folder."]},{"cref":"T:System.IO.FileNotFoundException","doc":["The folder has no ",{"c":"entryPoint"},"."]}]}}]},{"id":"T:Runic.Assets.AssetWatchOptions","namespace":"Runic.Assets","name":"AssetWatchOptions","kind":"class","signature":["public sealed class AssetWatchOptions"],"docs":{"summary":["Bounds filesystem event coalescing for a development asset source."]},"members":[{"id":"M:Runic.Assets.AssetWatchOptions.#ctor","kind":"constructor","name":"AssetWatchOptions","signature":["public AssetWatchOptions()"]},{"id":"P:Runic.Assets.AssetWatchOptions.DebounceDelay","kind":"property","name":"DebounceDelay","signature":["public ",["TimeSpan","T:System.TimeSpan"]," DebounceDelay { get; init; }"],"docs":{"summary":["Gets the quiet period required before one coalesced directory refresh runs."]}},{"id":"P:Runic.Assets.AssetWatchOptions.MaxRetryAttempts","kind":"property","name":"MaxRetryAttempts","signature":["public int MaxRetryAttempts { get; init; }"],"docs":{"summary":["Gets the number of automatic scan retries allowed for one coalesced change burst."]}},{"id":"P:Runic.Assets.AssetWatchOptions.RetryDelay","kind":"property","name":"RetryDelay","signature":["public ",["TimeSpan","T:System.TimeSpan"]," RetryDelay { get; init; }"],"docs":{"summary":["Gets the delay before a bounded retry after a transient directory scan failure."]}}]},{"id":"T:Runic.Assets.DevelopmentDirectoryAssetSource","namespace":"Runic.Assets","name":"DevelopmentDirectoryAssetSource","kind":"class","interfaces":["T:Runic.Assets.IAssetSource","T:Runic.Assets.IAssetSourceChangeNotifier","T:System.IDisposable"],"signature":["public sealed class DevelopmentDirectoryAssetSource : ",["IAssetSource","T:Runic.Assets.IAssetSource"],", ",["IAssetSourceChangeNotifier","T:Runic.Assets.IAssetSourceChangeNotifier"],", ",["IDisposable","T:System.IDisposable"]],"docs":{"summary":["Exposes a refreshable local development directory, such as a frontend's build output. Every refresh publishes an immutable manifest, every file is served with ",{"see":"F:Runic.Assets.AssetCacheMode.NoStore"},", and reads are verified against the manifest digest."],"remarks":[{"p":["No path component below the root may be a symbolic link or reparse point. On Linux and macOS the source pins the root with one no-follow directory handle and opens every file relative to it, so replacing the root or an ancestor directory cannot redirect a published source. Windows checks each component for a reparse point before it opens a file, but does not pin the root: a directory moved into the root's place is read from then on."]}," ",{"p":["Call ",{"see":"M:Runic.Assets.DevelopmentDirectoryAssetSource.StartWatching(Runic.Assets.AssetWatchOptions)"}," once to refresh after file changes, and dispose the source to stop."]}]},"members":[{"id":"M:Runic.Assets.DevelopmentDirectoryAssetSource.#ctor(System.String,System.String)","kind":"constructor","name":"DevelopmentDirectoryAssetSource","signature":["public DevelopmentDirectoryAssetSource(string rootDirectory, string entryPointRelativePath)"],"docs":{"summary":["Scans a local development directory and creates its first manifest snapshot."],"params":[{"name":"rootDirectory","doc":["The directory, absolute or relative to the current directory."]},{"name":"entryPointRelativePath","doc":["The entry document, relative to ",{"c":"rootDirectory"},", such as ",{"c":"index.html"},"."]}],"exceptions":[{"cref":"T:System.IO.InvalidDataException","doc":["The directory contains a symbolic link or reparse point."]},{"cref":"T:System.ArgumentException","doc":["The directory does not contain the entry point."]},{"cref":"T:System.PlatformNotSupportedException","doc":["The operating system is not Linux, Windows or macOS."]}]}},{"id":"P:Runic.Assets.DevelopmentDirectoryAssetSource.Manifest","kind":"property","name":"Manifest","signature":["public ",["AssetManifest","T:Runic.Assets.AssetManifest"]," Manifest { get; }"],"docs":{"summary":["Gets the current immutable manifest with identity, digest, and cache metadata."]},"inherited":"P:Runic.Assets.IAssetSource.Manifest"},{"id":"P:Runic.Assets.DevelopmentDirectoryAssetSource.SkippedEntries","kind":"property","name":"SkippedEntries","signature":["public ",["IReadOnlyList","T:System.Collections.Generic.IReadOnlyList`1"],"<string> SkippedEntries { get; }"],"docs":{"summary":["Gets the directory entries the latest scan skipped because their names are not valid asset paths, such as names containing ",{"c":":"},", ",{"c":"?"},", ",{"c":"#"},", a backslash, or a percent-encoded octet."]}},{"id":"M:Runic.Assets.DevelopmentDirectoryAssetSource.Dispose","kind":"method","name":"Dispose","signature":["public void Dispose()"],"docs":{"summary":["Stops the watch, future refreshes and notification admission; it is the only way to stop watching. A refresh in progress finishes first. Queued notifications are discarded and every external or repeated disposal call waits until callbacks admitted before disposal have finished. Disposal called by the active callback returns without waiting for itself; a later external disposal still waits for that callback. Subscriber exceptions are isolated and never affect a published refresh. Notifications are delivered in refresh order by one dispatcher; handlers may unsubscribe or refresh reentrantly, and changes queued by reentrancy run afterward."]}},{"id":"M:Runic.Assets.DevelopmentDirectoryAssetSource.OpenAsync(System.String,System.Threading.CancellationToken)","kind":"method","name":"OpenAsync","signature":["public ",["ValueTask","T:System.Threading.Tasks.ValueTask`1"],"<",["AssetReadSnapshot","T:Runic.Assets.AssetReadSnapshot"],"> OpenAsync(string relativePath, ",["CancellationToken","T:System.Threading.CancellationToken"]," cancellationToken = default)"],"docs":{"summary":["Opens one exact manifest asset with its matching immutable descriptor."],"remarks":["The caller owns the snapshot and disposes it, which disposes its content stream."],"exceptions":[{"cref":"T:System.IO.FileNotFoundException","doc":["The manifest does not declare ",{"c":"relativePath"},"."]}]},"inherited":"M:Runic.Assets.IAssetSource.OpenAsync(System.String,System.Threading.CancellationToken)"},{"id":"M:Runic.Assets.DevelopmentDirectoryAssetSource.RefreshAsync(System.Threading.CancellationToken)","kind":"method","name":"RefreshAsync","signature":["public ",["ValueTask","T:System.Threading.Tasks.ValueTask`1"],"<",["AssetManifest","T:Runic.Assets.AssetManifest"],"> RefreshAsync(",["CancellationToken","T:System.Threading.CancellationToken"]," cancellationToken = default)"],"docs":{"summary":["Scans the directory again and atomically replaces the manifest when its assets changed, then raises ",{"see":"E:Runic.Assets.DevelopmentDirectoryAssetSource.Changed"},". Refreshes run one at a time."],"returns":["The current manifest: the replacement, or the previous one when nothing changed."],"exceptions":[{"cref":"T:System.ArgumentException","doc":["The directory no longer contains the entry point."]},{"cref":"T:System.IO.InvalidDataException","doc":["The directory contains a symbolic link or reparse point."]},{"cref":"T:System.ObjectDisposedException","doc":["The source is disposed."]}]}},{"id":"M:Runic.Assets.DevelopmentDirectoryAssetSource.StartWatching(Runic.Assets.AssetWatchOptions)","kind":"method","name":"StartWatching","signature":["public void StartWatching(",["AssetWatchOptions","T:Runic.Assets.AssetWatchOptions"],"? options = null)"],"docs":{"summary":["Starts the source's filesystem watcher. File changes are coalesced into one refresh after the configured quiet period, and each replacement manifest is published through ",{"see":"E:Runic.Assets.DevelopmentDirectoryAssetSource.Changed"},". Subscribe before calling it. The watch runs until the source is disposed."],"params":[{"name":"options","doc":["The debounce and retry bounds; ",{"c":"null"}," uses the defaults."]}],"exceptions":[{"cref":"T:System.InvalidOperationException","doc":["The source is already watching."]},{"cref":"T:System.ObjectDisposedException","doc":["The source is disposed."]}]}},{"id":"M:Runic.Assets.DevelopmentDirectoryAssetSource.ValidateAsync(System.Threading.CancellationToken)","kind":"method","name":"ValidateAsync","signature":["public ",["ValueTask","T:System.Threading.Tasks.ValueTask"]," ValidateAsync(",["CancellationToken","T:System.Threading.CancellationToken"]," cancellationToken = default)"],"docs":{"summary":["Validates metadata and backing content."]},"inherited":"M:Runic.Assets.IAssetSource.