.git"}," directories and files whose names start with ",{"c":".env"}," are left out at any depth."],"params":[{"name":"sourceDirectory","doc":["The directory to pack."]},{"name":"destination","doc":["A writable stream that receives the archive."]},{"name":"options","doc":["The entry point and the paths to leave out."]},{"name":"cancellationToken","doc":["Cancels the scan and the write."]}],"exceptions":[{"cref":"T:System.PlatformNotSupportedException","doc":["The operating system is not Linux."]}]}},{"id":"M:Runic.Assets.AssetArchive.WriteTrustedDirectoryAsync(System.String,System.IO.Stream,Runic.Assets.AssetArchiveDirectoryOptions,System.Threading.CancellationToken)","kind":"method","name":"WriteTrustedDirectoryAsync","signature":["public static ",["ValueTask","T:System.Threading.Tasks.ValueTask"]," WriteTrustedDirectoryAsync(string sourceDirectory, ",["Stream","T:System.IO.Stream"]," destination, ",["AssetArchiveDirectoryOptions","T:Runic.Assets.AssetArchiveDirectoryOptions"],"? options = null, ",["CancellationToken","T:System.Threading.CancellationToken"]," cancellationToken = default)"],"docs":{"summary":["Writes a canonical archive from a directory that the same trusted build produced, on every operating system. By default ",{"c":".git"}," directories and files whose names start with ",{"c":".env"}," are left out at any depth."],"remarks":["The directory is read with ordinary file APIs into memory before the archive is written. Symbolic links, and on Windows every reparse point such as a junction, that the scan observes are rejected with ",{"see":"T:System.IO.InvalidDataException"},". The snapshot is not safe against a process that changes the directory while it is read; use ",{"see":"M:Runic.Assets.AssetArchive.WriteDirectoryAsync(System.String,System.IO.Stream,Runic.Assets.AssetArchiveDirectoryOptions,System.Threading.CancellationToken)"}," on Linux for a directory that a less trusted process can write."],"params":[{"name":"sourceDirectory","doc":["The directory to pack."]},{"name":"destination","doc":["A writable stream that receives the archive."]},{"name":"options","doc":["The entry point and the paths to leave out; ",{"c":"null"}," uses the defaults."]},{"name":"cancellationToken","doc":["Cancels the scan and the write."]}]}}]},{"id":"T:Runic.Assets.AssetArchiveDirectoryOptions","namespace":"Runic.Assets","name":"AssetArchiveDirectoryOptions","kind":"class","signature":["public sealed class AssetArchiveDirectoryOptions"],"docs":{"summary":["Selects the entry point and the files left out when ",{"see":"T:Runic.Assets.AssetArchive"}," packs a directory."]},"members":[{"id":"M:Runic.Assets.AssetArchiveDirectoryOptions.#ctor","kind":"constructor","name":"AssetArchiveDirectoryOptions","signature":["public AssetArchiveDirectoryOptions()"]},{"id":"P:Runic.Assets.AssetArchiveDirectoryOptions.EntryPoint","kind":"property","name":"EntryPoint","signature":["public string EntryPoint { get; init; }"],"docs":{"summary":["Gets the entry document relative to the directory, with ",{"c":"/"}," separators. Defaults to ",{"c":"index.html"},". It must exist and must not be excluded."]}},{"id":"P:Runic.Assets.AssetArchiveDirectoryOptions.ExcludeDefaultPatterns","kind":"property","name":"ExcludeDefaultPatterns","signature":["public bool ExcludeDefaultPatterns { get; init; }"],"docs":{"summary":["Gets whether ",{"c":".git"}," directories and files, and files whose names start with ",{"c":".env"}," (such as ",{"c":".env.local"}," or ",{"c":".envrc"},"), are left out at any depth. Names are compared without case. Defaults to ",{"c":"true"},"; set ",{"c":"false"}," to pack them."]}},{"id":"P:Runic.Assets.AssetArchiveDirectoryOptions.ExcludedPaths","kind":"property","name":"ExcludedPaths","signature":["public ",["ImmutableArray","T:System.Collections.Immutable.ImmutableArray`1"],"<string> ExcludedPaths { get; init; }"],"docs":{"summary":["Gets exact asset paths, relative to the directory with ",{"c":"/"}," separators, to leave out. Empty by de