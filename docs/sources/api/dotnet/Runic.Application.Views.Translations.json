ection, add ",{"see":"P:Runic.Application.Views.Translations.RunicViewsTranslations.CatalogRegistration"}," to the application's ",{"see":"T:Runic.Translations.TranslationContext"}," builder, set ",{"see":"M:Runic.Application.Views.Translations.RunicViewsTranslations.ValidationText(System.ComponentModel.DataAnnotations.ValidationAttribute,Runic.Application.Views.RunicValidationMember)"}," as ",{"see":"P:Runic.Application.Views.RunicValidationOptions.TextFor"},", and call ",{"see":"M:Runic.Application.Views.Translations.RunicViewsTranslations.FollowPlatformTexts(Runic.Translations.ITranslationContext,System.Action{System.ArgumentException})"},"."]}," ",{"p":["An application changes single messages, or adds a locale, in its own ",{"c":"runic.json"}," (",{"c":"\"overrides\""}," of the ",{"c":"runic-views"}," catalog from this package); the text it overrides follows the same locale."]}]},"members":[{"id":"F:Runic.Application.Views.Translations.RunicViewsTranslations.CatalogId","kind":"field","name":"CatalogId","signature":["public const string CatalogId = \"runic-views\""],"docs":{"summary":["The catalog's ID, ",{"c":"runic-views"},": the ",{"c":"\"catalog\""}," of an override in ",{"c":"runic.json"},"."]}},{"id":"P:Runic.Application.Views.Translations.RunicViewsTranslations.CatalogRegistration","kind":"property","name":"CatalogRegistration","signature":["public static ",["TranslationCatalogRegistration","T:Runic.Translations.TranslationCatalogRegistration"]," CatalogRegistration { get; }"],"docs":{"summary":["The ",{"c":"runic-views"}," catalog, for a ",{"see":"T:Runic.Translations.TranslationContext"}," builder: ",{"c":"TranslationContext.CreateBuilder().Add(AppTextCatalog.Registration).Add(RunicViewsTranslations.CatalogRegistration)"},". ",{"c":"AddRunicViewsTranslations()"}," registers it with ",{"c":"Runic.Translations.Hosting"},"."]}},{"id":"M:Runic.Application.Views.Translations.RunicViewsTranslations.FollowPlatformTexts(Runic.Translations.ITranslationContext,Sys