","signature":["public static ",["RunicViewsMenuTitles","T:Runic.Application.Views.Translations.RunicViewsMenuTitles"]," MenuTitles(",["ITranslationContext","T:Runic.Translations.ITranslationContext"]," context)"],"docs":{"summary":["The titles of Runic Desktop's standard macOS menus in the context's current locale, with ",{"c":"{0}"}," for the application's name, which Runic inserts. Map them to ",{"c":"DesktopStandardMenuTitles"},", whose members have the same names, and pass them to ",{"c":"DesktopHost.SetStandardMenuTitles"}," (the README shows how)."],"remarks":["This package does not reference ",{"c":"Runic.Desktop"},", so that CS-WebUI applications do not depend on it."],"params":[{"name":"context","doc":["A Translations context with ",{"see":"P:Runic.Application.Views.Translations.RunicViewsTranslations.CatalogRegistration"},"."]}],"exceptions":[{"cref":"T:System.ArgumentNullException","doc":[{"c":"context"}," is ",{"c":"null"},"."]},{"cref":"T:System.Collections.Generic.KeyNotFoundException","doc":["The context has no ",{"c":"runic-views"}," catalog."]}]}},{"id":"M:Runic.Application.Views.Translations.RunicViewsTranslations.PlatformTexts(Runic.Translations.ITranslationContext)","kind":"method","name":"PlatformTexts","signature":["public static ",["DesktopPlatformTexts","T:Runic.Platform.DesktopPlatformTexts"]," PlatformTexts(",["ITranslationContext","T:Runic.Translations.ITranslationContext"]," context)"],"docs":{"summary":["The ",{"see":"T:Runic.Platform.DesktopPlatformTexts"}," in the context's current locale: Linux dialog titles, the untitled file name, the macOS Choose an application title, the Linux keyring label, shortcut key names, a browser window's error pages and the title of a Windows window while WebView2 starts."],"params":[{"name":"context","doc":["A Translations context with ",{"see":"P:Runic.Application.Views.Translations.RunicViewsTranslations.CatalogRegistration"},"."]}],"exceptions":[{"cref":"T:System.ArgumentNullException","doc":[{"c":"c