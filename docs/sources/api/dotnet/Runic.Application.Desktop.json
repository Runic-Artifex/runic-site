mmary":["Binds native platform services to one open embedded Desktop window."],"remarks":["Pass the owner to a platform provider, for example ",{"c":"WindowsPlatformProvider.CreateFileDialogs(owner)"},", ",{"c":"LinuxPlatformProvider.CreateFileDialogs(owner)"}," on Linux with GTK 3, or ",{"c":"PortalPlatformProvider.CreateFileDialogs(Gtk4PlatformProvider.CreatePortalWindowOwner(owner))"}," with GTK 4 (",{"c":"LinuxPlatformProvider"}," parents through GTK 3 and must not be used with a GTK 4 window). The owner belongs to the ",{"see":"T:Runic.Desktop.DesktopWindow"}," it was created for: it becomes unavailable when that window closes or the surface opens a replacement, and a replacement window needs a new owner. The native handle is passed only to callbacks running on the window's native thread and must not outlive them. ",{"see":"P:Runic.Application.Views.Desktop.DesktopNativeOwner.IsAvailable"}," is ",{"c":"false"}," for any window without native dispatch, for example an installed-browser presentation or a custom window host without a native handle. Create and dispose owner-bound services while the window is open."]},"members":[{"id":"M:Runic.Application.Views.Desktop.DesktopNativeOwner.#ctor(Runic.Desktop.DesktopWindow)","kind":"constructor","name":"DesktopNativeOwner","signature":["public DesktopNativeOwner(",["DesktopWindow","T:Runic.Desktop.DesktopWindow"]," window)"],"docs":{"summary":["Creates an owner for ",{"c":"window"},"."],"params":[{"name":"window","doc":["The Desktop window whose native thread runs provider callbacks."]}]}},{"id":"P:Runic.Application.Views.Desktop.DesktopNativeOwner.Generation","kind":"property","name":"Generation","signature":["public ",["Guid","T:System.Guid"]," Generation { get; }"],"docs":{"summary":["The verified presentation generation, shared with its lifetime."],"remarks":["Each owner has its own generation; an owner never follows a replacement window."]},"inherited":"P:Runic.Platform.Runtime.INativePickerOwner.Generation"},{"id":"P:Runic.Application.Views.Desktop.DesktopNativeOwner.IsAvailable","kind":"property","name":"IsAvailable","signature":["public bool IsAvailable { get; }"],"docs":{"summary":["Whether the provider can currently show dialogs."],"remarks":[{"c":"true"}," while the window is the surface's current embedded window, is open, and supports native dispatch."]},"inherited":"P:Runic.Platform.Runtime.INativePickerOwner.IsAvailable"},{"id":"P:Runic.Application.Views.Desktop.DesktopNativeOwner.Window","kind":"property","name":"Window","signature":["public ",["DesktopWindow","T:Runic.Desktop.DesktopWindow"]," Window { get; }"],"docs":{"summary":["Gets the Desktop window this owner belongs to."]}},{"id":"M:Runic.Application.Views.Desktop.DesktopNativeOwner.CheckAccess","kind":"method","name":"CheckAccess","signature":["public bool CheckAccess()"],"docs":{"summary":["Gets whether the caller is running on the window's native thread."]}},{"id":"M:Runic.Application.Views.Desktop.DesktopNativeOwner.InvokeAsync(System.Action{System.IntPtr},System.Threading.CancellationToken)","kind":"method","name":"InvokeAsync","signature":["public ",["ValueTask","T:System.Threading.Tasks.ValueTask"]," InvokeAsync(",["Action","T:System.Action`1"],"<nint> action, ",["CancellationToken","T:System.Threading.CancellationToken"]," cancellationToken = default)"],"docs":{"summary":["Revalidates owner identity and dispatches on its native thread. The handle cannot escape the callback."],"exceptions":[{"cref":"T:Runic.Platform.Runtime.OwnerClosedException","doc":["The window closed or was replaced before the callback started."]}]},"inherited":"M:Runic.Platform.Runtime.INativePickerOwner.InvokeAsync(System.Action{System.IntPtr},System.Threading.CancellationToken)"}]}]}
