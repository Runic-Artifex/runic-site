<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Extracts the public API and XML documentation of a published NuGet package
    into JSON for the documentation portal. Run only by
    scripts/sync-api-inputs.mjs; the portal build never invokes .NET.
    It uses only the in-box System.Reflection.Metadata reader, so it restores
    without packages.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
